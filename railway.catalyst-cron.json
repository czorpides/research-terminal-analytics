{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.catalyst-cron"
  },
  "deploy": {
    "startCommand": "node scripts/catalyst-source-cron.mjs",
    "cronSchedule": "0 6,18 * * 1-5",
    "restartPolicyType": "NEVER"
  }
}
